#!/usr/bin/env python3
"""Verify an ECMWF ensemble tropical cyclone forecast against IBTrACS observations.

    ./trackver <STORMNAME>          e.g.  ./trackver GARANCE
    ./trackver <IBTrACS SID>        e.g.  ./trackver 2025054S17051

The program
  1. downloads the latest IBTrACS "last3years" CSV from NCEI (newest version found),
  2. finds when the storm was observed and lists the ECMWF ensemble runs that
     started during that time and exist in the S3 bucket,
  3. asks which run to use, downloads its BUFR track file from S3,
  4. plots the wind and pressure meteograms of the ensemble with the observed
     value at every forecast step, and a map of the ensemble track plumes with the
     observed positions, saves both figures in plots/ and shows them.

This is the S3 mode, which needs no ECMWF account. trackver_mars, next to it, takes
the forecasts from MARS instead and adds the AIFS ensemble. The code both share
(observations, tracks, plots) is in trackverlib.py.
"""

import sys
import urllib.request
import xml.etree.ElementTree as ET
from datetime import timedelta

from trackverlib import (TrackverError, command_line, find_storm, make_plots, observations,
                         pick_run, run_hours, runs_during, save_and_show)
# used by trackver.ipynb through this module
from trackverlib import choose_storm, download_ibtracs, observed_intensity, plt, read_ibtracs

try:
    import earthkit.data as ekd
except ImportError as error:
    sys.exit(f"trackver: {error}\nInstall earthkit-data >= 1.0 and pdbufr "
             "(see environment.yml).")


S3_ENDPOINT = "s3.eu-central-1.amazonaws.com"
S3_BUCKET = "ecmwf-static-datasets"
S3_PREFIX = "tropical-cyclone-tracks"


# ---------------------------------------------------------------------------
# ECMWF forecast runs on S3
# ---------------------------------------------------------------------------

def run_key(base):
    """S3 object key of the tropical cyclone track file of one ensemble run."""
    hours = run_hours(base)
    end = base + timedelta(hours=hours)
    name = (f"ecm_wf_{base:%Y%m%dT%H%M%S}Z_{end:%Y%m%dT%H%M%S}Z"
            f"_ifs-ens_od_enfo_tf_{hours}h.bufr")
    return f"{S3_PREFIX}/{base:%Y/%m}/{name}"


def s3_keys(months):
    """All object keys in the bucket for the given (year, month) folders, or None offline."""
    keys = set()
    namespace = {"s3": "http://s3.amazonaws.com/doc/2006-03-01/"}
    try:
        for year, month in months:
            token = ""
            while True:
                url = (f"https://{S3_BUCKET}.{S3_ENDPOINT}/?list-type=2"
                       f"&prefix={S3_PREFIX}/{year:04d}/{month:02d}/{token}")
                with urllib.request.urlopen(url, timeout=60) as reply:
                    tree = ET.fromstring(reply.read())
                keys |= {k.text for k in tree.iterfind(".//s3:Key", namespace)}
                more = tree.find("s3:NextContinuationToken", namespace)
                if more is None:
                    break
                token = "&continuation-token=" + urllib.request.quote(more.text)
    except OSError as error:
        print(f"warning: could not list the S3 bucket ({error}); offering every run")
        return None
    return keys


def candidate_runs(track, obs):
    """Runs that started while the storm was observed and whose file is on S3."""
    bases = runs_during(track, obs)
    keys = s3_keys(sorted({(b.year, b.month) for b in bases}))
    if keys is not None:
        bases = [b for b in bases if run_key(b) in keys]
    if not bases:
        raise TrackverError(f"no ECMWF track file on S3 for the time "
                            f"{track.NAME.iloc[0]} was observed")
    return bases


def forecast_storm(base, track):
    """Download one run from S3 and return the messages of the storm in it."""
    name = track.NAME.iloc[0]
    print(f"\nDownloading the {base:%Y-%m-%d %H} UTC run from S3 ...")
    source = {"endpoint": S3_ENDPOINT, "bucket": S3_BUCKET, "objects": run_key(base)}
    fl = ekd.from_source("s3", source, anon=True).to_featurelist()

    here = track.iloc[(track.time - base).abs().argmin()]     # observed centre at the base time
    found, how = find_storm(fl, name, here.LAT, here.LON)
    if not found:
        raise TrackverError(
            f"{name} is not in the {base:%Y-%m-%d %H} UTC forecast file. The forecast only "
            "tracks storms that were analysed at its start, which early, weak stages "
            "often are not; try a later run.")
    print(f"Found {name} in the forecast {how}.")
    return fl[found]


# ---------------------------------------------------------------------------

def main():
    args = command_line("Plot ECMWF ensemble wind and pressure meteograms for a tropical "
                        "cyclone, verified against IBTrACS observations, with the "
                        "forecasts from S3.", "GARANCE")
    try:
        track, obs, obs_label = observations(args)
        base = pick_run(args, track, obs, candidate_runs(track, obs))
        storm = forecast_storm(base, track)
    except TrackverError as error:
        sys.exit(f"trackver: {error}")
    figures = make_plots(storm, track, base, obs, obs_label, args.max_hours)
    save_and_show({"": figures}, track, base, args)


if __name__ == "__main__":
    main()
